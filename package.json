{
  "name": "@thezzisu/canvas",
  "version": "0.1.4",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server:dev": "node --import tsx server/main.ts",
    "server": "node dist/cli/main.js serve",
    "build:server": "node scripts/build-server.mjs",
    "build:web": "vite build",
    "deploy:web": "wrangler pages deploy dist/web",
    "build": "npm run build:server && npm run build:web",
    "start": "node dist/cli/main.js serve",
    "prepack": "VITE_CANVAS_BUILTIN_SERVER=true npm run build",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --import tsx --test \"{server,shared,web/src,cli}/**/*.test.ts\" \"*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/headless": "^6.0.0",
    "hono": "^4.13.14",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@comark/vue": "^0.8.1",
    "@iconify-json/lucide": "^1.2.148",
    "@intlify/unplugin-vue-i18n": "^11.2.8",
    "@nuxt/ui": "^4.12.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vue-flow/node-resizer": "^1.5.1",
    "@vueuse/core": "^10.11.1",
    "@xterm/xterm": "^6.0.0",
    "comark": "^0.8.1",
    "mime": "^4.1.2",
    "prettier": "^3.9.10",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-tsc": "^3.3.13",
    "wrangler": "4.156.0"
  },
  "files": [
    "dist",
    "!dist/**/licenses/**",
    "!dist/**/.vite/license.md",
    "LICENSE",
    "README.md"
  ],
  "description": "A browser workspace for local and SSH-connected herdr windows",
  "license": "Apache-2.0",
  "bin": {
    "canvas": "dist/cli/main.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thezzisu/canvas.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "!win32"
  ]
}
