#!/usr/bin/env python3
"""Open a file, folder or web address from a connected Canvas terminal."""

import argparse
import json
import os
from pathlib import Path
import select
import socket
import stat
import sys
import time
from urllib.parse import urlsplit


class CanvasError(Exception):
    pass


BRIDGE_PERMISSION_DENIED = "cannot access Canvas bridge: permission denied"


def terminal_identity():
    native_socket = os.environ.get("HERDR_SOCKET_PATH", "")
    pane = os.environ.get("HERDR_PANE_ID", "")
    if native_socket and pane and os.path.isabs(native_socket) and len(pane) <= 256:
        if all(ord(char) >= 32 and ord(char) != 127 for char in pane):
            return os.path.realpath(native_socket), pane
    raise CanvasError("run this command inside a connected herdr pane")


def routing_error(message):
    native_socket, pane = terminal_identity()
    return CanvasError(message + "\n  HERDR_SOCKET_PATH=" + json.dumps(native_socket)
                       + " HERDR_PANE_ID=" + json.dumps(pane))


def registry_entries(native_socket):
    directory = os.environ.get("CANVAS_BRIDGE_REGISTRY_DIR") or os.path.expanduser(
        "~/.local/state/canvas/bridges"
    )
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        parent = os.open(directory, flags | getattr(os, "O_DIRECTORY", 0))
    except PermissionError:
        raise CanvasError(BRIDGE_PERMISSION_DENIED) from None
    except OSError:
        return []
    entries = []
    try:
        info = os.fstat(parent)
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
            return []
        for name in os.listdir(parent):
            if not name.endswith(".json"):
                continue
            try:
                fd = os.open(name, flags | os.O_NONBLOCK, dir_fd=parent)
                with os.fdopen(fd, "rb") as record:
                    info = os.fstat(record.fileno())
                    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                            or stat.S_IMODE(info.st_mode) != 0o600 or info.st_size > 16384):
                        continue
                    entry = json.loads(record.read(16385))
                if not isinstance(entry, dict) or entry.get("version") != 1:
                    continue
                registered_socket = entry.get("nativeSocket")
                endpoint = entry.get("socket")
                secret = entry.get("secret")
                if not isinstance(registered_socket, str) or not os.path.isabs(registered_socket) or os.path.realpath(registered_socket) != native_socket:
                    continue
                if not isinstance(endpoint, str) or not os.path.isabs(endpoint) or "\0" in endpoint:
                    continue
                if not isinstance(secret, str) or not 16 <= len(secret) <= 256:
                    continue
                endpoint_stat = os.stat(endpoint, follow_symlinks=False)
                if (not stat.S_ISSOCK(endpoint_stat.st_mode) or endpoint_stat.st_uid != os.getuid()):
                    continue
                entries.append((info.st_mtime_ns, entry))
            except PermissionError:
                raise CanvasError(BRIDGE_PERMISSION_DENIED) from None
            except (OSError, ValueError, UnicodeError):
                continue
    finally:
        os.close(parent)
    # Duplicate records for one endpoint can occur during credential rotation.
    entries.sort(key=lambda item: item[0], reverse=True)
    seen = set()
    result = []
    for _, entry in entries:
        if entry["socket"] not in seen:
            try:
                with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
                    probe.settimeout(0.5)
                    probe.connect(entry["socket"])
            except PermissionError:
                raise CanvasError(BRIDGE_PERMISSION_DENIED) from None
            except OSError:
                continue
            seen.add(entry["socket"])
            result.append(entry)
    if len(result) > 1:
        raise CanvasError("multiple Canvas connections match this terminal")
    return result


class DownloadProgress:
    def __init__(self, stream=None):
        self.stream = stream if stream is not None else sys.stderr
        self.enabled = self.stream.isatty()
        self.width = 0

    def draw(self, text):
        if self.enabled:
            self.stream.write("\r" + text + " " * max(0, self.width - len(text)))
            self.stream.flush()
            self.width = len(text)

    def waiting(self):
        self.draw("Copying to Canvas...")

    def update(self, transferred, size):
        fraction = transferred / size if size else 1
        filled = min(24, int(fraction * 24))
        self.draw("Copying [" + "=" * filled + " " * (24 - filled) + "] "
                  + f"{fraction * 100:3.0f}%  {self.bytes(transferred)} / {self.bytes(size)}")

    @staticmethod
    def bytes(value):
        for unit in ("B", "KiB", "MiB", "GiB", "TiB", "PiB"):
            if value < 1024 or unit == "PiB":
                return f"{value:.0f} {unit}" if unit == "B" else f"{value:.1f} {unit}"
            value /= 1024

    def finish(self):
        if self.enabled and self.width:
            self.stream.write("\n")
            self.stream.flush()
            self.width = 0


def rejected_response(result, started):
    # Do not echo server text: it could contain terminal controls or a reflected
    # request, including the private bridge credential.
    reason = result.get("reason")
    if reason == "not-attached":
        return routing_error("no browser ready to receive from this pane")
    if reason == "pane-unavailable":
        return routing_error("herdr pane is unavailable")
    messages = {
        "cancelled": "copy cancelled",
        "not-started": "copy did not start",
        "timed-out": "copy timed out",
        "disconnected": "copy connection closed",
        "invalid-transfer": "file transfer failed",
    }
    return CanvasError(messages.get(reason if isinstance(reason, str) else None,
        "file transfer failed" if started else "open request rejected"))


def transfer_file(connection, file, size, progress=None, start_timeout=70, idle_timeout=65):
    """Copy to Canvas while reading the server's acknowledgements together.

    The server reports bytes written to its staging area. Socket writability
    alone is not progress: an SSH buffer can accept data while storage is stuck.
    Timeouts measure inactivity, so a progressing large download has no total
    duration limit. Optional timeout arguments support isolated protocol tests.
    """
    progress = progress if progress is not None else DownloadProgress()
    connection.setblocking(False)
    started = False
    acknowledged = 0
    remaining = size
    pending = memoryview(b"")
    replies = bytearray()
    write_closed = False
    deadline = time.monotonic() + start_timeout
    progress.waiting()
    try:
        while True:
            wait = deadline - time.monotonic()
            if wait <= 0:
                raise CanvasError("copy timed out" if started else "copy did not start")
            readable, writable, _ = select.select([connection],
                [connection] if started and not write_closed else [], [], wait)
            # Read cancellations first, including while the socket send buffer
            # is full. A blocking sendall here can otherwise wait forever.
            if readable:
                try:
                    chunk = connection.recv(16384)
                except BlockingIOError:
                    chunk = None
                if chunk == b"":
                    raise CanvasError("copy connection closed")
                if chunk:
                    replies.extend(chunk)
                    while b"\n" in replies:
                        line, _, rest = replies.partition(b"\n")
                        replies = bytearray(rest)
                        if len(line) > 8192:
                            raise CanvasError("invalid copy response")
                        try:
                            result = json.loads(line)
                        except (ValueError, UnicodeError):
                            raise CanvasError("invalid copy response") from None
                        if not isinstance(result, dict):
                            raise CanvasError("invalid copy response")
                        if result.get("ok") is False:
                            raise rejected_response(result, started)
                        state = result.get("state")
                        if not started:
                            if state == "offered" and "ok" not in result:
                                if result.get("transferred") != 0 or result.get("size") != size:
                                    raise CanvasError("invalid copy response")
                                continue
                            if result.get("ok") is not True or state != "transferring":
                                raise CanvasError("invalid copy response")
                            if result.get("transferred") != 0 or result.get("size") != size:
                                raise CanvasError("invalid copy response")
                            started = True
                            deadline = time.monotonic() + idle_timeout
                            progress.update(0, size)
                            continue
                        if result.get("ok") is True and state == "completed":
                            if (remaining or pending or not write_closed
                                    or result.get("transferred") != size or result.get("size") != size):
                                raise CanvasError("invalid copy response")
                            progress.update(size, size)
                            return
                        if state != "transferring" or "ok" in result:
                            raise CanvasError("invalid copy response")
                        transferred = result.get("transferred")
                        if (not isinstance(transferred, int) or isinstance(transferred, bool)
                                or transferred < acknowledged or transferred > size - remaining
                                or result.get("size") != size):
                            raise CanvasError("invalid copy response")
                        if transferred > acknowledged:
                            acknowledged = transferred
                            deadline = time.monotonic() + idle_timeout
                            progress.update(transferred, size)
                    if len(replies) > 8192:
                        raise CanvasError("invalid copy response")
            if writable:
                if not pending and remaining:
                    data = file.read(min(65536, remaining))
                    if not data:
                        raise CanvasError("file changed during transfer")
                    pending = memoryview(data)
                if pending:
                    try:
                        sent = connection.send(pending)
                    except BlockingIOError:
                        sent = 0
                    if sent:
                        pending = pending[sent:]
                        remaining -= sent
                if not remaining and not pending:
                    connection.shutdown(socket.SHUT_WR)
                    write_closed = True
    finally:
        progress.finish()


def open_directory(connection, header, timeout=15):
    noun = "web address" if header.get("kind") == "url" else "directory"
    if sys.stderr.isatty():
        print("Opening " + noun + " in Canvas...", file=sys.stderr, flush=True)
    deadline = time.monotonic() + timeout
    try:
        encoded = json.dumps(header, ensure_ascii=True, separators=(",", ":")).encode("ascii") + b"\n"
        if len(encoded) > 16384:
            raise CanvasError("open request is too long")
        connection.settimeout(timeout)
        connection.sendall(encoded)
        connection.shutdown(socket.SHUT_WR)
        line = bytearray()
        while len(line) <= 8192:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise CanvasError("open request timed out")
            connection.settimeout(remaining)
            chunk = connection.recv(1)
            if not chunk:
                raise CanvasError("open connection closed")
            if chunk == b"\n":
                try:
                    result = json.loads(line)
                except (ValueError, UnicodeError):
                    raise CanvasError("invalid open response") from None
                if not isinstance(result, dict):
                    raise CanvasError("invalid open response")
                if result.get("ok") is True:
                    return
                if result.get("ok") is False:
                    if result.get("reason") == "editor-unavailable":
                        raise CanvasError("VS Code connection is unavailable")
                    if result.get("reason") == "url-unavailable":
                        raise CanvasError("web address could not be opened")
                    if result.get("reason") == "not-started":
                        raise CanvasError("browser did not receive this " + noun)
                    raise rejected_response(result, False)
                raise CanvasError("invalid open response")
            line.extend(chunk)
        raise CanvasError("invalid open response")
    except TimeoutError:
        raise CanvasError("open request timed out") from None


def open_url(value):
    try:
        parsed = urlsplit(value)
        if parsed.scheme not in ("http", "https") or not parsed.hostname or parsed.username or parsed.password:
            raise ValueError()
        if parsed.port is not None and not 1 <= parsed.port <= 65535:
            raise ValueError()
        if len(value) > 8192 or any(ord(char) <= 32 or ord(char) == 127 for char in value):
            raise ValueError()
    except ValueError:
        raise CanvasError("invalid web address") from None
    native_socket, pane = terminal_identity()
    entries = registry_entries(native_socket)
    if not entries:
        raise routing_error("no Canvas bridge for this herdr socket")
    entry = entries[0]
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(30)
        try:
            connection.connect(entry["socket"])
        except PermissionError:
            raise CanvasError(BRIDGE_PERMISSION_DENIED) from None
        open_directory(connection, {"version": 1, "secret": entry["secret"],
            "nativeSocket": native_socket, "paneId": pane, "kind": "url", "url": value})


def open_file(path):
    path = os.path.abspath(path)
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        info = os.fstat(fd)
        is_directory = stat.S_ISDIR(info.st_mode)
        if not is_directory and not stat.S_ISREG(info.st_mode):
            os.close(fd)
            raise CanvasError("choose a file or directory")
        if is_directory:
            os.close(fd)
            path = os.path.realpath(path)
            file = None
        else:
            file = os.fdopen(fd, "rb")
    except OSError as error:
        if isinstance(error, FileNotFoundError):
            raise CanvasError("file not found") from None
        raise CanvasError("cannot read this file") from None
    def transfer(connection, entry, native_socket, pane):
        header = {
            "version": 1,
            "secret": entry["secret"],
            "nativeSocket": native_socket,
            "paneId": pane,
        }
        if is_directory:
            if any(ord(char) < 32 or ord(char) == 127 for char in path):
                raise CanvasError("invalid directory path")
            open_directory(connection, {**header, "kind": "directory", "path": path})
            return
        with file:
            header = {
                **header,
                "kind": "file",
                "filename": os.path.basename(path),
                "size": info.st_size,
            }
            encoded = json.dumps(header, ensure_ascii=True, separators=(",", ":")).encode("ascii") + b"\n"
            if len(encoded) > 16384:
                raise CanvasError("copy request is too long")
            connection.sendall(encoded)
            transfer_file(connection, file, info.st_size)

    try:
        native_socket, pane = terminal_identity()
        entries = registry_entries(native_socket)
        if not entries:
            raise routing_error("no Canvas bridge for this herdr socket")
        entry = entries[0]
        # Registry discovery has already rejected ambiguous destinations.
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(30)
            try:
                connection.connect(entry["socket"])
            except PermissionError:
                raise CanvasError(BRIDGE_PERMISSION_DENIED) from None
            transfer(connection, entry, native_socket, pane)
    finally:
        if file:
            file.close()


def installed_canvas():
    """Identify this product without executing an unrelated same-name command."""
    own = Path(__file__).resolve()
    seen = set()
    for directory in os.get_exec_path():
        candidate = Path(directory or os.curdir) / "canvas"
        try:
            resolved = candidate.resolve(strict=True)
            info = resolved.stat()
            identity = (info.st_dev, info.st_ino)
            if identity in seen or os.path.samefile(resolved, own):
                continue
            seen.add(identity)
            if not stat.S_ISREG(info.st_mode) or not os.access(resolved, os.X_OK):
                continue
            # The package owns one stable bin location, including npm's symlink.
            if resolved.name != "main.js" or resolved.parent.name != "cli" or resolved.parent.parent.name != "dist":
                continue
            root = resolved.parent.parent.parent
            package = root / "package.json"
            if package.stat().st_size > 65536:
                continue
            metadata = json.loads(package.read_text())
            if metadata.get("name") != "@thezzisu/canvas" or metadata.get("bin", {}).get("canvas") != "dist/cli/main.js":
                continue
            if os.path.samefile(root / metadata["bin"]["canvas"], resolved):
                return str(resolved)
        except (OSError, ValueError, TypeError, AttributeError, RuntimeError):
            continue
    return None


def main():
    if os.environ.get("CANVAS_HELPER_DIRECT") != "1":
        installed = installed_canvas()
        if installed:
            try:
                os.execv(installed, [installed, *sys.argv[1:]])
            except OSError:
                print("canvas: cannot start the installed Canvas CLI", file=sys.stderr)
                return 1
    parser = argparse.ArgumentParser(prog="canvas", description="Open a file, folder or web address in Canvas.")
    commands = parser.add_subparsers(dest="command", required=True)
    command = commands.add_parser("open", help="open a file, folder or web address", epilog=
        "Routing uses HERDR_SOCKET_PATH and HERDR_PANE_ID from this process. "
        "A daemon must receive the originating pane's values for each invocation.")
    command.add_argument("path", help="file, folder or HTTP(S) address")
    arguments = parser.parse_args()
    try:
        if arguments.path.lower().startswith(("http://", "https://")):
            open_url(arguments.path)
        else:
            open_file(arguments.path)
    except CanvasError as error:
        print("canvas: " + str(error), file=sys.stderr)
        return 1
    except (OSError, ValueError):
        print("canvas: file transfer failed", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("canvas: cancelled", file=sys.stderr)
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
