#!/usr/bin/env python3
# @thezzisu/canvas managed helper
"""Open files and capture web applications from a connected Canvas terminal."""

import argparse
import hashlib
import http.client
import json
import os
from pathlib import Path
import re
import select
import signal
import socket
import stat
import subprocess
import sys
import time
from urllib.parse import urlsplit


class CanvasError(Exception):
    pass


BRIDGE_PERMISSION_DENIED = "cannot access Canvas bridge: permission denied"


selected_runtime = None


def identity_runtime():
    if selected_runtime:
        return selected_runtime
    core = bool(os.environ.get("HC_TERMINAL_SOCKET") or os.environ.get("HC_TERMINAL_ID"))
    tui = bool(os.environ.get("HERDR_SOCKET_PATH") or os.environ.get("HERDR_PANE_ID"))
    if core and tui:
        raise CanvasError("both Core and TUI identities are present; specify --runtime core or --runtime tui")
    return "core" if core else "tui"


def terminal_identity():
    core = identity_runtime() == "core"
    native_socket = os.environ.get("HC_TERMINAL_SOCKET" if core else "HERDR_SOCKET_PATH", "")
    pane = os.environ.get("HC_TERMINAL_ID" if core else "HERDR_PANE_ID", "")
    if native_socket and pane and os.path.isabs(native_socket) and len(pane) <= 256:
        if all(ord(char) >= 32 and ord(char) != 127 for char in pane):
            return os.path.realpath(native_socket), pane
    raise CanvasError("run this command inside a connected herdr pane")


def routing_error(message):
    native_socket, pane = terminal_identity()
    core = identity_runtime() == "core"
    socket_key, pane_key = ("HC_TERMINAL_SOCKET", "HC_TERMINAL_ID") if core else ("HERDR_SOCKET_PATH", "HERDR_PANE_ID")
    return CanvasError(message + "\n  " + socket_key + "=" + json.dumps(native_socket)
                       + " " + pane_key + "=" + json.dumps(pane))


def registry_entries(native_socket):
    directory = os.environ.get("CANVAS_BRIDGE_REGISTRY_DIR") or os.path.expanduser(
        "~/.local/state/canvas/bridges"
    )
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        parent = os.open(directory, flags | getattr(os, "O_DIRECTORY", 0))
    except PermissionError:
        raise CanvasError(BRIDGE_PERMISSION_DENIED) from None
    except OSError:
        return []
    entries = []
    try:
        info = os.fstat(parent)
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
            return []
        for name in os.listdir(parent):
            if not name.endswith(".json"):
                continue
            try:
                fd = os.open(name, flags | os.O_NONBLOCK, dir_fd=parent)
                with os.fdopen(fd, "rb") as record:
                    info = os.fstat(record.fileno())
                    if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                            or stat.S_IMODE(info.st_mode) != 0o600 or info.st_size > 16384):
                        continue
                    entry = json.loads(record.read(16385))
                if not isinstance(entry, dict) or entry.get("version") != 1:
                    continue
                registered_socket = entry.get("nativeSocket")
                endpoint = entry.get("socket")
                secret = entry.get("secret")
                if not isinstance(registered_socket, str) or not os.path.isabs(registered_socket) or os.path.realpath(registered_socket) != native_socket:
                    continue
                if not isinstance(endpoint, str) or not os.path.isabs(endpoint) or "\0" in endpoint:
                    continue
                if not isinstance(secret, str) or not 16 <= len(secret) <= 256:
                    continue
                endpoint_stat = os.stat(endpoint, follow_symlinks=False)
                if (not stat.S_ISSOCK(endpoint_stat.st_mode) or endpoint_stat.st_uid != os.getuid()):
                    continue
                entries.append((info.st_mtime_ns, entry))
            except PermissionError:
                raise CanvasError(BRIDGE_PERMISSION_DENIED) from None
            except (OSError, ValueError, UnicodeError):
                continue
    finally:
        os.close(parent)
    # Duplicate records for one endpoint can occur during credential rotation.
    entries.sort(key=lambda item: item[0], reverse=True)
    seen = set()
    result = []
    for _, entry in entries:
        if entry["socket"] not in seen:
            try:
                with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
                    probe.settimeout(0.5)
                    probe.connect(entry["socket"])
            except PermissionError:
                raise CanvasError(BRIDGE_PERMISSION_DENIED) from None
            except OSError:
                continue
            seen.add(entry["socket"])
            result.append(entry)
    if len(result) > 1:
        raise CanvasError("multiple Canvas connections match this terminal")
    return result


class DownloadProgress:
    def __init__(self, stream=None):
        self.stream = stream if stream is not None else sys.stderr
        self.enabled = self.stream.isatty()
        self.width = 0

    def draw(self, text):
        if self.enabled:
            self.stream.write("\r" + text + " " * max(0, self.width - len(text)))
            self.stream.flush()
            self.width = len(text)

    def waiting(self):
        self.draw("Copying to Canvas...")

    def update(self, transferred, size):
        fraction = transferred / size if size else 1
        filled = min(24, int(fraction * 24))
        self.draw("Copying [" + "=" * filled + " " * (24 - filled) + "] "
                  + f"{fraction * 100:3.0f}%  {self.bytes(transferred)} / {self.bytes(size)}")

    @staticmethod
    def bytes(value):
        for unit in ("B", "KiB", "MiB", "GiB", "TiB", "PiB"):
            if value < 1024 or unit == "PiB":
                return f"{value:.0f} {unit}" if unit == "B" else f"{value:.1f} {unit}"
            value /= 1024

    def finish(self):
        if self.enabled and self.width:
            self.stream.write("\n")
            self.stream.flush()
            self.width = 0


def rejected_response(result, started):
    # Do not echo server text: it could contain terminal controls or a reflected
    # request, including the private bridge credential.
    reason = result.get("reason")
    if reason == "not-attached":
        return routing_error("no browser ready to receive from this pane")
    if reason == "pane-unavailable":
        return routing_error("herdr pane is unavailable")
    messages = {
        "cancelled": "copy cancelled",
        "not-started": "copy did not start",
        "timed-out": "copy timed out",
        "disconnected": "copy connection closed",
        "invalid-transfer": "file transfer failed",
    }
    return CanvasError(messages.get(reason if isinstance(reason, str) else None,
        "file transfer failed" if started else "open request rejected"))


def transfer_file(connection, file, size, progress=None, start_timeout=70, idle_timeout=65):
    """Copy to Canvas while reading the server's acknowledgements together.

    The server reports bytes written to its staging area. Socket writability
    alone is not progress: an SSH buffer can accept data while storage is stuck.
    Timeouts measure inactivity, so a progressing large download has no total
    duration limit. Optional timeout arguments support isolated protocol tests.
    """
    progress = progress if progress is not None else DownloadProgress()
    connection.setblocking(False)
    started = False
    acknowledged = 0
    remaining = size
    pending = memoryview(b"")
    replies = bytearray()
    write_closed = False
    deadline = time.monotonic() + start_timeout
    progress.waiting()
    try:
        while True:
            wait = deadline - time.monotonic()
            if wait <= 0:
                raise CanvasError("copy timed out" if started else "copy did not start")
            readable, writable, _ = select.select([connection],
                [connection] if started and not write_closed else [], [], wait)
            # Read cancellations first, including while the socket send buffer
            # is full. A blocking sendall here can otherwise wait forever.
            if readable:
                try:
                    chunk = connection.recv(16384)
                except BlockingIOError:
                    chunk = None
                if chunk == b"":
                    raise CanvasError("copy connection closed")
                if chunk:
                    replies.extend(chunk)
                    while b"\n" in replies:
                        line, _, rest = replies.partition(b"\n")
                        replies = bytearray(rest)
                        if len(line) > 8192:
                            raise CanvasError("invalid copy response")
                        try:
                            result = json.loads(line)
                        except (ValueError, UnicodeError):
                            raise CanvasError("invalid copy response") from None
                        if not isinstance(result, dict):
                            raise CanvasError("invalid copy response")
                        if result.get("ok") is False:
                            raise rejected_response(result, started)
                        state = result.get("state")
                        if not started:
                            if state == "offered" and "ok" not in result:
                                if result.get("transferred") != 0 or result.get("size") != size:
                                    raise CanvasError("invalid copy response")
                                continue
                            if result.get("ok") is not True or state != "transferring":
                                raise CanvasError("invalid copy response")
                            if result.get("transferred") != 0 or result.get("size") != size:
                                raise CanvasError("invalid copy response")
                            started = True
                            deadline = time.monotonic() + idle_timeout
                            progress.update(0, size)
                            continue
                        if result.get("ok") is True and state == "completed":
                            if (remaining or pending or not write_closed
                                    or result.get("transferred") != size or result.get("size") != size):
                                raise CanvasError("invalid copy response")
                            progress.update(size, size)
                            return
                        if state != "transferring" or "ok" in result:
                            raise CanvasError("invalid copy response")
                        transferred = result.get("transferred")
                        if (not isinstance(transferred, int) or isinstance(transferred, bool)
                                or transferred < acknowledged or transferred > size - remaining
                                or result.get("size") != size):
                            raise CanvasError("invalid copy response")
                        if transferred > acknowledged:
                            acknowledged = transferred
                            deadline = time.monotonic() + idle_timeout
                            progress.update(transferred, size)
                    if len(replies) > 8192:
                        raise CanvasError("invalid copy response")
            if writable:
                if not pending and remaining:
                    data = file.read(min(65536, remaining))
                    if not data:
                        raise CanvasError("file changed during transfer")
                    pending = memoryview(data)
                if pending:
                    try:
                        sent = connection.send(pending)
                    except BlockingIOError:
                        sent = 0
                    if sent:
                        pending = pending[sent:]
                        remaining -= sent
                if not remaining and not pending:
                    connection.shutdown(socket.SHUT_WR)
                    write_closed = True
    finally:
        progress.finish()


def open_directory(connection, header, timeout=15):
    noun = "web address" if header.get("kind") == "url" else "directory"
    if sys.stderr.isatty():
        print("Opening " + noun + " in Canvas...", file=sys.stderr, flush=True)
    deadline = time.monotonic() + timeout
    try:
        connection.settimeout(timeout)
        send(connection, header)
        connection.shutdown(socket.SHUT_WR)
        line = bytearray()
        while len(line) <= 8192:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise CanvasError("open request timed out")
            connection.settimeout(remaining)
            chunk = connection.recv(1)
            if not chunk:
                raise CanvasError("open connection closed")
            if chunk == b"\n":
                try:
                    result = json.loads(line)
                except (ValueError, UnicodeError):
                    raise CanvasError("invalid open response") from None
                if not isinstance(result, dict):
                    raise CanvasError("invalid open response")
                if result.get("ok") is True:
                    return
                if result.get("ok") is False:
                    if result.get("reason") == "editor-unavailable":
                        raise CanvasError("VS Code connection is unavailable")
                    if result.get("reason") == "url-unavailable":
                        raise CanvasError("web address could not be opened")
                    if result.get("reason") == "not-started":
                        raise CanvasError("browser did not receive this " + noun)
                    raise rejected_response(result, False)
                raise CanvasError("invalid open response")
            line.extend(chunk)
        raise CanvasError("invalid open response")
    except TimeoutError:
        raise CanvasError("open request timed out") from None


def open_url(value):
    try:
        parsed = urlsplit(value)
        if parsed.scheme not in ("http", "https") or not parsed.hostname or parsed.username or parsed.password:
            raise ValueError()
        if parsed.port is not None and not 1 <= parsed.port <= 65535:
            raise ValueError()
        if len(value) > 8192 or any(ord(char) <= 32 or ord(char) == 127 for char in value):
            raise ValueError()
    except ValueError:
        raise CanvasError("invalid web address") from None
    native_socket, pane = terminal_identity()
    entries = registry_entries(native_socket)
    if not entries:
        raise routing_error("no Canvas bridge for this herdr socket")
    entry = entries[0]
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(30)
        try:
            connection.connect(entry["socket"])
        except PermissionError:
            raise CanvasError(BRIDGE_PERMISSION_DENIED) from None
        open_directory(connection, {"version": 1, "secret": entry["secret"],
            "nativeSocket": native_socket, "paneId": pane, "kind": "url", "url": value})


def open_file(path):
    path = os.path.abspath(path)
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        info = os.fstat(fd)
        is_directory = stat.S_ISDIR(info.st_mode)
        if not is_directory and not stat.S_ISREG(info.st_mode):
            os.close(fd)
            raise CanvasError("choose a file or directory")
        if is_directory:
            os.close(fd)
            path = os.path.realpath(path)
            file = None
        else:
            file = os.fdopen(fd, "rb")
    except OSError as error:
        if isinstance(error, FileNotFoundError):
            raise CanvasError("file not found") from None
        raise CanvasError("cannot read this file") from None
    def transfer(connection, entry, native_socket, pane):
        header = {
            "version": 1,
            "secret": entry["secret"],
            "nativeSocket": native_socket,
            "paneId": pane,
        }
        if is_directory:
            if any(ord(char) < 32 or ord(char) == 127 for char in path):
                raise CanvasError("invalid directory path")
            open_directory(connection, {**header, "kind": "directory", "path": path})
            return
        with file:
            header = {
                **header,
                "kind": "file",
                "filename": os.path.basename(path),
                "size": info.st_size,
            }
            send(connection, header)
            transfer_file(connection, file, info.st_size)

    try:
        native_socket, pane = terminal_identity()
        entries = registry_entries(native_socket)
        if not entries:
            raise routing_error("no Canvas bridge for this herdr socket")
        entry = entries[0]
        # Registry discovery has already rejected ambiguous destinations.
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(30)
            try:
                connection.connect(entry["socket"])
            except PermissionError:
                raise CanvasError(BRIDGE_PERMISSION_DENIED) from None
            transfer(connection, entry, native_socket, pane)
    finally:
        if file:
            file.close()


def installed_canvas(require_matching_helper=False):
    """Identify this product without executing an unrelated same-name command."""
    own = Path(__file__).resolve()
    seen = set()
    checksum = hashlib.sha256(own.read_bytes()).digest() if require_matching_helper else None
    for directory in os.get_exec_path():
        candidate = Path(directory or os.curdir) / "canvas"
        try:
            resolved = candidate.resolve(strict=True)
            info = resolved.stat()
            identity = (info.st_dev, info.st_ino)
            if identity in seen or os.path.samefile(resolved, own):
                continue
            seen.add(identity)
            if not stat.S_ISREG(info.st_mode) or not os.access(resolved, os.X_OK):
                continue
            # The package owns one stable bin location, including npm's symlink.
            if resolved.name != "main.js" or resolved.parent.name != "cli" or resolved.parent.parent.name != "dist":
                continue
            root = resolved.parent.parent.parent
            package = root / "package.json"
            if package.stat().st_size > 65536:
                continue
            metadata = json.loads(package.read_text())
            if metadata.get("name") != "@thezzisu/canvas" or metadata.get("bin", {}).get("canvas") != "dist/cli/main.js":
                continue
            if require_matching_helper:
                bundled = root / "dist/cli/canvas"
                if bundled.stat().st_size > 8 * 1024 * 1024 or hashlib.sha256(bundled.read_bytes()).digest() != checksum:
                    continue
            if os.path.samefile(root / metadata["bin"]["canvas"], resolved):
                return str(resolved)
        except (OSError, ValueError, TypeError, AttributeError, RuntimeError):
            continue
    return None


def send(connection, value, limit=16384):
    payload = (json.dumps(value, separators=(",", ":"), ensure_ascii=False) + "\n").encode("utf-8")
    if len(payload) > limit:
        raise CanvasError("Canvas request is too long")
    connection.sendall(payload)


def line(connection, timeout=30):
    deadline = time.monotonic() + timeout
    data = bytearray()
    while len(data) <= 32768:
        wait = deadline - time.monotonic()
        if wait <= 0 or not select.select([connection], [], [], wait)[0]:
            raise CanvasError("capture bridge timed out")
        part = connection.recv(1)
        if not part:
            raise CanvasError("capture bridge closed")
        if part == b"\n":
            try:
                value = json.loads(data)
                if isinstance(value, dict):
                    return value
            except (ValueError, UnicodeError):
                pass
            raise CanvasError("invalid capture response")
        data.extend(part)
    raise CanvasError("capture response is too large")


def port_open(port):
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=0.15):
            return True
    except OSError:
        return False


def available_port():
    with socket.socket() as listener:
        listener.bind(("127.0.0.1", 0))
        return listener.getsockname()[1]


def expand(value, environment):
    """Expand named variables only. Never invoke a shell or evaluate syntax."""
    def replace(match):
        if match.group() == "$$":
            return "$"
        name = match[1] or match[2]
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
            raise CanvasError("only $NAME and ${NAME} placeholders are supported in --env values")
        if name not in environment:
            raise CanvasError("undefined child environment variable: " + name)
        return environment[name]
    return re.sub(r"\$\$|\$\{([^}]*)\}|\$([A-Za-z_][A-Za-z0-9_]*)", replace, value)


def probe_http(port, path, public, deadline):
    connection = http.client.HTTPConnection("127.0.0.1", port, timeout=max(0.01, min(0.35, deadline - time.monotonic())))
    try:
        connection.request("GET", path, headers={"Host": public.netloc, "X-Forwarded-Prefix": public.path.rstrip("/"), "Connection": "close"})
        return connection.getresponse().status
    except (OSError, http.client.HTTPException):
        return None
    finally:
        connection.close()


def probe_command(command, environment, port, deadline):
    probe = subprocess.Popen(command, shell=True, env={**environment, "PORT": str(port), "CANVAS_CAPTURE_PORT": str(port)},
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    try:
        return probe.wait(timeout=max(0.01, min(1, deadline - time.monotonic()))) == 0
    except subprocess.TimeoutExpired:
        return False
    finally:
        # A probe is temporary, including any children of its explicit shell.
        try:
            os.killpg(probe.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        try:
            probe.wait(timeout=1)
        except subprocess.TimeoutExpired:
            raise CanvasError("readiness probe did not stop") from None


def bootstrap_file(filename, public_url, port):
    if not filename:
        return None
    try:
        fd = os.open(filename, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0) | os.O_NONBLOCK)
    except FileNotFoundError:
        return False
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077 or info.st_size > 32768:
            raise CanvasError("capture bootstrap file must be a private regular file owned by this account")
        with os.fdopen(fd, "rb") as stream:
            fd = None
            try:
                value = json.load(stream)
            except (ValueError, UnicodeError):
                return False
    finally:
        if fd is not None:
            os.close(fd)
    url = value.get("launchUrl", value.get("url")) if isinstance(value, dict) else None
    if not isinstance(url, str) or len(url.encode("utf-8")) > 16384 or any(ord(c) <= 32 or ord(c) == 127 for c in url):
        raise CanvasError("invalid application bootstrap URL")
    try:
        parsed, public = urlsplit(url), urlsplit(public_url)
        is_public = (parsed.scheme, parsed.netloc) == (public.scheme, public.netloc) and parsed.path.startswith(public.path)
        is_loopback = parsed.scheme == "http" and parsed.hostname in ("localhost", "127.0.0.1") and (parsed.port or 80) == port
        if parsed.username or parsed.password or not (is_public or is_loopback):
            raise ValueError()
    except ValueError:
        raise CanvasError("application bootstrap URL does not match this capture") from None
    return url


def terminate(child):
    if getattr(child, "_canvas_terminated", False):
        return
    child._canvas_terminated = True
    try:
        os.killpg(child.pid, signal.SIGTERM)
    except ProcessLookupError:
        child.wait(timeout=5)
        return
    # The process group, not the launcher PID, owns wrapper descendants.
    # Reap the direct child while waiting; group probes work on POSIX hosts.
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        child.poll()
        try:
            os.killpg(child.pid, 0)
        except ProcessLookupError:
            break
        time.sleep(0.05)
    else:
        try:
            os.killpg(child.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    child.wait(timeout=5)



def capture_application(args, parser):
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if args.shell is not None:
        if command or not args.shell.strip():
            parser.error("--shell requires a script and cannot be combined with a command")
        command = ["/bin/sh", "-c", args.shell]
    if not command:
        parser.error("a command is required")
    if args.port is not None and not 1 <= args.port <= 65535 or not 0 < args.timeout <= 600:
        parser.error("port must be 1–65535 and timeout must be 0–600 seconds")
    if args.probe and (not args.probe.startswith("/") or any(ord(c) <= 32 or ord(c) == 127 for c in args.probe)):
        parser.error("--probe requires an HTTP path without whitespace, e.g. /health")
    if args.ready == "tcp" and (args.probe is not None or args.probe_command is not None) or args.probe is not None and args.probe_command is not None:
        parser.error("choose one of --ready tcp, --probe or --probe-command")
    overrides = []
    for value in args.env:
        name, separator, value = value.partition("=")
        if not separator or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
            parser.error("--env requires NAME=VALUE")
        overrides.append((name, value))
    if args.port is not None and port_open(args.port):
        raise CanvasError("capture port is already in use; the command was not started")
    port = args.port or available_port()

    native_socket, pane = terminal_identity()
    entries = registry_entries(native_socket)
    if not entries:
        raise CanvasError("no Canvas bridge for this terminal")
    entry = entries[0]
    child = None
    requested_signal = [None]
    def interrupted(number, _frame):
        requested_signal[0] = number
        if child is not None and child.poll() is None:
            try:
                os.killpg(child.pid, number)
            except ProcessLookupError:
                pass
    for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(number, interrupted)
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.connect(entry["socket"])
            send(connection, {"version": 1, "secret": entry["secret"], "nativeSocket": native_socket, "paneId": pane,
                              "kind": "capture", "port": port, "title": (args.title or Path(command[0]).name)[:120]})
            response = line(connection)
            public_url = response.get("publicUrl")
            if response.get("ok") is not True or response.get("state") != "prepared" or not isinstance(public_url, str):
                raise CanvasError("Canvas could not prepare this terminal capture")
            public = urlsplit(public_url)
            if public.scheme not in ("http", "https") or not public.netloc or public.username or public.password:
                raise CanvasError("invalid capture public URL")
            environment = dict(os.environ)
            environment["CANVAS_CAPTURE_PUBLIC_URL"] = public_url
            environment["CANVAS_CAPTURE_HOST"] = public.netloc
            environment["PORT"] = environment["CANVAS_CAPTURE_PORT"] = str(port)
            for name, value in overrides:
                environment[name] = expand(value, environment)
            if environment["PORT"] != str(port) or environment["CANVAS_CAPTURE_PORT"] != str(port):
                raise CanvasError("use --port to change the capture port")
            if requested_signal[0]:
                return 128 + requested_signal[0]
            child = subprocess.Popen(command, env=environment, start_new_session=True)
            deadline = time.monotonic() + args.timeout
            ready_url = False
            while child.poll() is None and not requested_signal[0]:
                if select.select([connection], [], [], 0)[0]:
                    value = line(connection, 1)
                    if value.get("action") == "stop":
                        terminate(child)
                        return 0
                    raise CanvasError("capture bridge rejected startup")
                if args.probe_command:
                    ready = probe_command(args.probe_command, environment, port, deadline)
                elif args.ready == "tcp":
                    ready = port_open(port)
                else:
                    status = probe_http(port, args.probe or "/", public, deadline)
                    ready = status is not None and (200 <= status < 300 if args.probe else 200 <= status < 500)
                if ready and time.monotonic() < deadline:
                    ready_url = bootstrap_file(args.bootstrap_file, public_url, port)
                    if ready_url is not False:
                        break
                if time.monotonic() >= deadline:
                    raise CanvasError("command did not become ready on PORT before the startup deadline; use PORT or specify --port")
                time.sleep(0.1)
            if child.poll() is not None or requested_signal[0]:
                return child.returncode if child.returncode is not None and child.returncode >= 0 else 128 + (requested_signal[0] or -child.returncode)
            send(connection, {"action": "ready", **({"bootstrapUrl": ready_url} if ready_url else {})}, 32768)
            response = line(connection)
            if response.get("ok") is not True or response.get("state") != "ready":
                raise CanvasError("Canvas could not display this captured application")
            print("canvas: Web view ready; return to this terminal without stopping, or stop the captured command.", file=sys.stderr)
            while child.poll() is None and not requested_signal[0]:
                if select.select([connection], [], [], 0.2)[0]:
                    response = line(connection, 1)
                    if response.get("action") == "stop":
                        terminate(child)
                        return 0
                    raise CanvasError("capture bridge closed the application view")
            if requested_signal[0]:
                return 128 + requested_signal[0]
            result = child.returncode
            return result if result >= 0 else 128 - result
    finally:
        if child is not None:
            terminate(child)


def main():
    global selected_runtime
    if os.environ.get("CANVAS_HELPER_DIRECT") != "1":
        installed = installed_canvas(sys.argv[1:2] in (["open"], ["capture"]))
        if installed:
            try:
                os.execv(installed, [installed, *sys.argv[1:]])
            except OSError:
                print("canvas: cannot start the installed Canvas CLI", file=sys.stderr)
                return 1
    parser = argparse.ArgumentParser(prog="canvas", description=__doc__)
    commands = parser.add_subparsers(dest="subcommand", required=True)
    opened = commands.add_parser("open", help="open a file, folder or web address", epilog=
        "Routing uses HERDR_SOCKET_PATH and HERDR_PANE_ID, or HC_TERMINAL_SOCKET and HC_TERMINAL_ID, from this process. "
        "A daemon must receive the originating pane's values for each invocation.")
    opened.add_argument("--runtime", choices=["core", "tui"], help="select the originating runtime in nested terminals")
    opened.add_argument("path", help="file, folder or HTTP(S) address")
    capture = commands.add_parser("capture", help="run a command and display its Web UI", epilog=
        "PORT and CANVAS_CAPTURE_PORT are provided to the command. Command arguments are passed unchanged. "
        "Use -c 'python3 -m http.server \"$PORT\"' for explicit shell expansion. "
        "Only --env values expand named variables; $$ means a literal $. Options must precede the command.")
    capture.add_argument("--port", type=int, help="use this loopback port instead of assigning PORT")
    capture.add_argument("--title", help="application title shown on the terminal")
    capture.add_argument("--bootstrap-file", help="private auth/bootstrap JSON containing launchUrl or url (not a readiness probe)")
    capture.add_argument("--ready", choices=["http", "tcp"], default="http", help="HTTP response (default) or TCP listener readiness")
    capture.add_argument("--probe", help="HTTP path that must return 2xx before capture, e.g. /health")
    capture.add_argument("--probe-command", help="explicit shell readiness command; exit 0 means ready, with PORT set to the selected port")
    capture.add_argument("--env", action="append", default=[], metavar="NAME=VALUE", help="child-only environment override; named variables expand after PORT injection")
    capture.add_argument("-c", "--shell", help="run this explicit shell script instead of a command")
    capture.add_argument("--timeout", type=float, default=120, help="startup deadline in seconds")
    capture.add_argument("--runtime", choices=["core", "tui"], help="explicit identity for nested terminal environments")
    capture.add_argument("command", nargs=argparse.REMAINDER)
    arguments = parser.parse_args()
    selected_runtime = arguments.runtime
    try:
        if arguments.subcommand == "capture":
            return capture_application(arguments, capture)
        if arguments.path.lower().startswith(("http://", "https://")):
            open_url(arguments.path)
        else:
            open_file(arguments.path)
    except subprocess.SubprocessError:
        print("canvas: capture process did not stop within the cleanup deadline", file=sys.stderr)
        return 1
    except CanvasError as error:
        print("canvas: " + str(error), file=sys.stderr)
        return 1
    except (OSError, ValueError):
        print("canvas: " + ("capture failed" if arguments.subcommand == "capture" else "file transfer failed"), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("canvas: cancelled", file=sys.stderr)
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
